<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cui.mapper.SysInstrumentBorrowMapper">

    <resultMap type="SysInstrumentBorrow" id="BorrowResult">
        <result property="borrowId" column="borrow_id"/>
        <result property="instrumentId" column="instrument_id"/>
        <result property="userId" column="user_id"/>
        <result property="userName" column="user_name"/>
        <result property="borrowTime" column="borrow_time"/>
        <result property="planReturnTime" column="plan_return_time"/>
        <result property="returnTime" column="return_time"/>
        <result property="status" column="status"/>
        <result property="auditUserId" column="audit_user_id"/>
        <result property="auditRemark" column="audit_remark"/>
        <result property="auditTime" column="audit_time"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
        <result property="instrumentName" column="instrument_name"/>
        <result property="auditUserName" column="audit_user_name"/>
    </resultMap>

    <sql id="selectBorrowVo">
        select b.*, i.instrument_name, u.user_name as audit_user_name
        from sys_instrument_borrow b
                 left join sys_instrument i on b.instrument_id = i.instrument_id
                 left join sys_user u on b.audit_user_id = u.user_id
    </sql>

    <select id="instrumentBorrowed" resultMap="BorrowResult">
        select * from sys_instrument_borrow where instrument_id=#{instrumentId} and status=1
    </select>

    <select id="selectBorrowList" parameterType="SysInstrumentBorrow" resultMap="BorrowResult">
        <include refid="selectBorrowVo"/>
        <where>
            <if test="instrumentName != null and instrumentName != ''">and i.instrument_name like concat('%', #{instrumentName}, '%')</if>
            <if test="userName != null and userName != ''">and b.user_name like concat('%', #{userName}, '%')</if>
            <if test="status != null and status != ''">and b.status = #{status}</if>
            <if test="instrumentId != null">and b.instrument_id = #{instrumentId}</if>
        </where>
        order by b.create_time desc
    </select>

    <select id="selectBorrowById" parameterType="Long" resultMap="BorrowResult">
        <include refid="selectBorrowVo"/> where b.borrow_id = #{borrowId}
    </select>

    <insert id="insertBorrow" parameterType="SysInstrumentBorrow" useGeneratedKeys="true" keyProperty="borrowId">
        insert into sys_instrument_borrow
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="instrumentId != null">instrument_id,</if>
            <if test="userId != null">user_id,</if>
            <if test="userName != null">user_name,</if>
            <if test="planReturnTime != null">plan_return_time,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="instrumentId != null">#{instrumentId},</if>
            <if test="userId != null">#{userId},</if>
            <if test="userName != null">#{userName},</if>
            <if test="planReturnTime != null">#{planReturnTime},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateBorrow" parameterType="SysInstrumentBorrow">
        update sys_instrument_borrow
        <set>
            <if test="instrumentId != null">instrument_id = #{instrumentId},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="userName != null">user_name = #{userName},</if>
            <if test="borrowTime != null">borrow_time = #{borrowTime},</if>
            <if test="planReturnTime != null">plan_return_time = #{planReturnTime},</if>
            <if test="returnTime != null">return_time = #{returnTime},</if>
            <if test="status != null">status = #{status},</if>
            <if test="auditUserId != null">audit_user_id = #{auditUserId},</if>
            <if test="auditRemark != null">audit_remark = #{auditRemark},</if>
            <if test="auditTime != null">audit_time = #{auditTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </set>
        where borrow_id = #{borrowId}
    </update>

    <delete id="deleteBorrowById" parameterType="Long">
        delete from sys_instrument_borrow where borrow_id = #{borrowId}
    </delete>

    <delete id="deleteBorrowByIds" parameterType="Long">
        delete from sys_instrument_borrow where borrow_id in
        <foreach collection="array" item="borrowId" open="(" separator="," close=")">
            #{borrowId}
        </foreach>
    </delete>


    <!-- 根据仪器ID列表统计借用次数 -->
    <select id="countByInstrumentIds" resultType="java.lang.Integer">
        select count(*) from sys_instrument_borrow
        where instrument_id in
        <foreach collection="instrumentIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <!-- 根据时间范围统计借用次数 -->
    <select id="countByBorrowTimeBetween" resultType="java.lang.Integer">
        select count(*) from sys_instrument_borrow
        where borrow_time between #{start} and #{end}
    </select>

    <!-- 根据状态统计数量 -->
    <select id="countByStatus" resultType="java.lang.Integer">
        select count(*) from sys_instrument_borrow
        where status = #{status}
    </select>

    <!-- 查询用户最近1条借用记录 -->
    <select id="selectLatestByUserId" resultMap="BorrowResult">
        select * from sys_instrument_borrow
        where user_id = #{userId}
        order by borrow_time desc
            limit 1
    </select>

    <!-- 统计仪器指定时间后的借用次数 -->
    <select id="countByInstrumentIdAndTime" resultType="java.lang.Integer">
        select count(*) from sys_instrument_borrow
        where instrument_id = #{instrumentId}
          and borrow_time >= #{startTime}
    </select>

    <!-- 查询仪器最近1条借用记录 -->
    <select id="selectLatestBorrowByInstrumentId" resultMap="BorrowResult">
        select * from sys_instrument_borrow
        where instrument_id = #{instrumentId}
          and status in ('0', '1')
        order by plan_return_time desc
            limit 1
    </select>

    <!-- 放到 SysInstrumentBorrowMapper.xml 中 -->

    <!-- 查询超期借用记录 -->
    <select id="selectOverdueBorrowList" resultMap="BorrowResult">
        <include refid="selectBorrowVo"/>
        where b.status = '1'
        and b.plan_return_time &lt; now()
        <if test="instrumentId != null">
            and b.instrument_id = #{instrumentId}
        </if>
    </select>

    <!-- 统计仪器月使用次数 -->
    <select id="countInstrumentMonthUse" resultType="java.lang.Integer">
        select count(*) from sys_instrument_borrow
        where instrument_id = #{instrumentId}
          and borrow_time >= #{monthStart}
    </select>
</mapper>